\documentclass[12pt,aspectratio=169]{beamer} \usepackage[utf8]{inputenc} \usepackage[russian]{babel} \usepackage{amsmath} \usepackage{amssymb} \usepackage{array} \usepackage{booktabs} \usepackage{xcolor} \usepackage{tikz} % Theme \usetheme{Madrid} \usecolortheme{default} \setbeamertemplate{navigation symbols}{} \setbeamertemplate{footline}[page number] % Define colors \definecolor{darkblue}{RGB}{0,102,204} \definecolor{lightgray}{RGB}{240,240,240} \definecolor{alertred}{RGB}{204,0,0} \setbeamercolor{title}{fg=darkblue} \setbeamercolor{frametitle}{fg=darkblue} \setbeamercolor{structure}{fg=darkblue} % Author info \title{Traceability in Industry 4.0} \subtitle{Intelligent Systems for Supply Chain Management} \author{Daniel Bicmetov \\ 6114-100503D} \institute{Samara State Aerospace University} \date{December 2024} \begin{document} % Title slide \begin{frame}[plain] \titlepage \end{frame} % Table of Contents \begin{frame} \frametitle{Outline} \tableofcontents \end{frame} % ============================================ \section{Problem and Goal} % ============================================ \begin{frame} \frametitle{Problem and Goal} \begin{alertblock}{Why Intelligent Traceability?} Industry 4.0 generates massive heterogeneous data from: \begin{itemize}[<+->] \item IoT sensors \item Cyber-physical systems \item Smart manufacturing devices \end{itemize} \end{alertblock} \pause \begin{block}{Current Challenges} \begin{itemize} \item Data integration across multiple sources \item Real-time transparency requirements \item Supply chain safety assurance \end{itemize} \end{block} \end{frame} % ============================================ \section{Core Idea} % ============================================ \begin{frame} \frametitle{Core Idea: Three-Layer Architecture} \begin{columns} \column{0.33\textwidth} \begin{exampleblock}{Layer 1: Semantic} \small Ontology-based representation \begin{itemize} \item Concepts \item Relations \item Instances \end{itemize} \end{exampleblock} \column{0.33\textwidth} \begin{exampleblock}{Layer 2: Integration} \small Data aggregation \begin{itemize} \item Collection \item Normalization \item Fusion \end{itemize} \end{exampleblock} \column{0.33\textwidth} \begin{exampleblock}{Layer 3: Cloud} \small Platform access \begin{itemize} \item Query interface \item Real-time sync \item Access control \end{itemize} \end{exampleblock} \end{columns} \end{frame} % ============================================ \section{System Architecture} % ============================================ \begin{frame} \frametitle{Ontology-Based Modeling} \begin{block}{Formal Definition} Let $O = \{C, R, I\}$ where: \begin{align*} C &= \{\text{Product, Process, Quality, Location, Agent}\}\\ R &= \{\text{hasStage, hasQuality, hasTrace, hasLocation}\}\\ I &= \{\text{Specific instances with timestamps}\} \end{align*} \end{block} \pause \begin{block}{Key Benefits} \alert{Semantic interoperability} through unified representation enables: \begin{itemize} \item Data mapping from heterogeneous sources \item Cross-system communication \item Automated reasoning \end{itemize} \end{block} \end{frame} \begin{frame} \frametitle{Data Integration Mechanism} \begin{table} \centering \small \begin{tabular}{|l|l|l|} \hline \textbf{Stage} & \textbf{Input} & \textbf{Output} \\ \hline Collection & Raw sensor data (JSON, XML) & Structured data \\ \hline Normalization & Multi-format streams & Ontology concepts \\ \hline Aggregation & Distributed data & Unified knowledge base \\ \hline Query & User request & Traced product info \\ \hline \end{tabular} \caption{IoT Data Processing Pipeline} \end{table} \pause Data transformation function: \[ D_{\text{transformed}} = f(D_{\text{raw}}, O) = \text{Map}(D_{\text{raw}}) \to O_{\text{concepts}} \] \end{frame} % ============================================ \section{Implementation} % ============================================ \begin{frame} \frametitle{Cloud-Based Platform} \begin{block}{Architecture Components} \only<1>{ \textbf{Frontend:} Web interface for stakeholder access } \only<2>{ \textbf{Backend:} Query engine and reasoning module } \only<3>{ \textbf{Database:} Cloud-hosted knowledge base } \only<4>{ \textbf{Security:} Access control and encryption } \end{block} \pause[4] \begin{alertblock}{Key Feature} \alert{Real-time synchronization} across supply chain actors ensures: \begin{itemize} \item Immediate product status updates \item Automated quality checks \item Regulatory compliance monitoring \end{itemize} \end{alertblock} \end{frame} % ============================================ \section{Key Results} % ============================================ \begin{frame} \frametitle{System Capabilities and Results} \begin{columns}[T] \column{0.5\textwidth} \begin{block}{Technical Achievements} \begin{itemize}[<+->] \item Solved heterogeneity challenges \item Automated data integration \item Enhanced interoperability \item Real-time querying \end{itemize} \end{block} \column{0.5\textwidth} \begin{block}{Business Value} \begin{itemize}[<+->] \item Full supply chain visibility \item Quality assurance automation \item Compliance documentation \item Product safety guarantee \end{itemize} \end{block} \end{columns} \end{frame} % ============================================ \section{Key Challenge \& Solution} % ============================================ \begin{frame} \frametitle{Key Challenge: Data Heterogeneity} \begin{alertblock}{Challenge} Industry 4.0 sources produce \alert{multiple data formats}: \begin{itemize} \item JSON from IoT platforms \item XML from legacy systems \item Binary sensor streams \item Database records \end{itemize} \end{alertblock} \pause \begin{exampleblock}{Solution: Semantic Mapping} Ontology enables intelligent schema transformation: \[ I(S_1, S_2) = \text{similarity}(\text{schema}_1, \text{schema}_2, O_{\text{mapping}}) \] where $O_{\text{mapping}}$ defines concept correspondences across systems \end{exampleblock} \end{frame} % ============================================ \section{Conclusion} % ============================================ \begin{frame} \frametitle{Conclusion} \begin{block}{Key Takeaways} \begin{itemize}[<+->] \item Industry 4.0 demands intelligent, semantically-grounded traceability \item Ontology-based architecture enables true interoperability \item Cloud platform provides scalable, accessible solution \item Addresses critical supply chain transparency and safety needs \end{itemize} \end{block} \pause \begin{exampleblock}{Future Directions} Integration with \alert{blockchain} for immutable, distributed tracking across multi-party ecosystems \end{exampleblock} \end{frame} \begin{frame}[plain] \centering \Large \textbf{Thank You!}\\[2em] \normalsize Questions \& Discussion\\[1em] \scriptsize Bougdira, Akharraz, Ahaitouf (2020)\\ Journal of Ambient Intelligence and Humanized Computing \end{frame} \end{document} % ============================================ % HANDOUT VERSION % ============================================ % To generate handout version, uncomment the line below at the top: % \documentclass[12pt,aspectratio=169,handout]{beamer} % This creates a print-friendly version with all overlays on single slides 
