        <bib:pages>135-144</bib:pages>
        <bib:presentedAt>
            <bib:Conference>
                <dc:title>13th IEEE International Conference on Requirements Engineering (RE'05)</dc:title>
            </bib:Conference>
        </bib:presentedAt>
    </rdf:Description>
